{
  "name": "ryvo-brand-film",
  "private": true,
  "description": "The /automations brand film (Remotion). Kept apart from the Next app.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:mp4": "remotion render src/index.ts BrandFilm out/brand-film.mp4 --codec=h264 --crf=16 --x264-preset=slow --pixel-format=yuv420p --scale=1.3333333333333333 --concurrency=4",
    "render:webm": "remotion ffmpeg -y -i out/brand-film.mp4 -c:v libvpx-vp9 -crf 30 -b:v 0 -row-mt 1 -an out/brand-film.webm",
    "render:poster": "remotion still src/index.ts BrandFilm out/brand-film-poster.png --frame=500 --scale=1.3333333333333333"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "^4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/media": "^4.0.536",
    "@remotion/motion-blur": "^4.0.536",
    "@remotion/transitions": "^4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
