{
  "name": "ryvo-brand-film",
  "private": true,
  "description": "The /automations brand film (Remotion). Kept apart from the Next app.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:mp4": "remotion render src/index.ts BrandFilm out/brand-film.mp4 --codec=h264 --crf=26 --pixel-format=yuv420p",
    "render:webm": "remotion render src/index.ts BrandFilm out/brand-film.webm --codec=vp9 --crf=36",
    "render:poster": "remotion still src/index.ts BrandFilm out/brand-film-poster.png --frame=0"
  },
  "dependencies": {
    "@remotion/cli": "4.0.536",
    "@remotion/fonts": "^4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.536"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "typescript": "5.9.3"
  }
}
